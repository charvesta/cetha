---
import {
  Accordion,
  AccordionItem,
  Alert,
  Avatar,
  AvatarGroup,
  Badge,
  Breadcrumbs,
  Button,
  ButtonGroup,
  Card,
  CardBody,
  CardFooter,
  CardHeader,
  Checkbox,
  Combobox,
  ComboboxOption,
  Collapsible,
  CommandItem,
  CommandPalette,
  ContextMenu,
  ContextMenuItem,
  Dialog,
  Divider,
  Dropdown,
  EmptyState,
  Field,
  FileInput,
  Icon,
  Input,
  InputGroup,
  Kbd,
  Link,
  Loader,
  LoadingOverlay,
  NavigationRail,
  NotificationItem,
  Pagination,
  PasswordInput,
  Popover,
  ProgressBar,
  RadioGroup,
  Select,
  SelectableCard,
  Sheet,
  Sidebar,
  Skeleton,
  Surface,
  Stat,
  Step,
  Stepper,
  Switch,
  Tab,
  TabPanel,
  Table,
  Tabs,
  Text,
  Textarea,
  ToastRegion,
  Tooltip,
} from '@charvesta/cetha';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cetha UI — Astro-native components">
  <aside class="library-sidebar" aria-label="Library navigation">
    <a class="sidebar-brand" href="/" aria-label="Cetha UI home"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><strong>Cetha</strong></a>
    <button class="sidebar-search" type="button" data-cetha-command-open="erp-command"><Icon name="search" size={15} /><span>Search...</span><Kbd>⌘ K</Kbd></button>
    <nav>
      <a class="active" href="#foundations">Home</a>
      <p>Components</p>
      <a href="#foundations">Foundations</a><a href="#forms">Forms</a><a href="#feedback">Feedback</a><a href="#erp">ERP patterns</a><a href="#overlays">Overlays</a><a href="#navigation">Navigation</a><a href="#data">Data</a>
    </nav>
    <a class="sidebar-repo" href="https://github.com/charvesta/cetha">GitHub repository <Icon name="arrowRight" size={14} /></a>
  </aside>
  <header class="site-header">
    <a class="brand" href="/" aria-label="Cetha UI home">
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>Cetha UI</span>
    </a>
    <span class="package-version">@charvesta/cetha <Badge>v0.1.8</Badge></span>
    <div class="header-actions">
      <Button size="sm" variant="ghost" data-cetha-command-open="erp-command"><Icon name="search" size={16} /> Cari <Kbd>⌘ K</Kbd></Button>
      <Button id="mode-toggle" size="sm" variant="ghost" aria-pressed="false"><Icon name="settings" size={16} /> <span data-mode-label>Dark mode</span></Button>
    </div>
  </header>

  <main>
    <section class="intro">
      <div>
        <p class="eyebrow">Astro-native component library</p>
        <h1>Cetha UI</h1>
        <p class="lead">Accessible, semantic components for calm operational products. Server-rendered by default, progressively enhanced where interaction needs it.</p>
        <div class="intro-actions">
          <Button variant="primary" data-cetha-dialog-open="install-dialog">Install Cetha</Button>
          <Link href="#foundations">Browse components <Icon name="arrowRight" size={16} /></Link>
        </div>
      </div>
      <div class="install-line" aria-label="Install command">
        <code>npm install @charvesta/cetha</code>
        <Badge tone="success">SSR ready</Badge>
      </div>
    </section>

    <div class="docs-grid">
      <aside class="toc">
        <p>On this page</p>
        <a href="#foundations">Foundations</a>
        <a href="#forms">Forms</a>
        <a href="#feedback">Feedback</a>
        <a href="#erp">ERP patterns</a>
        <a href="#overlays">Overlays</a>
        <a href="#navigation">Navigation</a>
        <a href="#data">Data</a>
      </aside>

      <div class="catalogue">
        <section id="foundations" class="doc-section">
          <header><p>01</p><div><h2>Foundations</h2><span>Typography, action, status, and surface primitives.</span></div></header>
          <div class="demo type-demo">
            <Text as="h3" variant="heading1">Heading one</Text>
            <Text as="h3" variant="heading2">Heading two</Text>
            <Text>Body copy stays compact and readable at fourteen pixels.</Text>
            <Text variant="caption">Supporting context remains quiet.</Text>
          </div>
          <Divider />
          <div class="demo row-demo">
            <Button variant="primary">Primary action</Button>
            <Button>Secondary</Button>
            <Button variant="ghost">Ghost</Button>
            <Button variant="danger">Delete</Button>
            <Button loading>Saving</Button>
          </div>
          <div class="demo density-demo" aria-label="Button sizes">
            <span>26</span><Button size="sm">Small</Button>
            <span>36</span><Button size="md">Default</Button>
            <span>40</span><Button size="lg">Large</Button>
          </div>
          <div class="demo row-demo">
            <Badge>Neutral</Badge><Badge tone="info">Info</Badge><Badge tone="success">Active</Badge><Badge tone="warning">Pending</Badge><Badge tone="danger">Failed</Badge>
          </div>
          <div class="demo icon-demo" aria-label="Cetha icon set">
            {(['alert', 'arrowLeft', 'arrowRight', 'check', 'chevronDown', 'close', 'copy', 'eye', 'eyeOff', 'info', 'menu', 'search', 'settings', 'success', 'warning'] as const).map((name) => (
              <span title={name}><Icon name={name} size={20} /><small>{name}</small></span>
            ))}
          </div>
        </section>

        <section id="forms" class="doc-section">
          <header><p>02</p><div><h2>Forms</h2><span>Native controls with deterministic IDs and visible relationships.</span></div></header>
          <Surface bordered class="demo form-demo">
            <div class="control-sizes" aria-label="Input sizes">
              <Input size="sm" aria-label="Small input" value="Small · 28px" />
              <Input size="md" aria-label="Default input" value="Default · 36px" />
              <Input size="lg" aria-label="Large input" value="Large · 44px" />
            </div>
            <div class="two-columns">
              <Field id="workspace-name" label="Workspace name" description="Shown to everyone in this workspace." required>
                <Input id="workspace-name" name="workspace" value="Arunika Operations" required aria-describedby="workspace-name-description" />
              </Field>
              <Field id="region" label="Primary region">
                <Select id="region" name="region"><option>Jakarta</option><option>Singapore</option></Select>
              </Field>
            </div>
            <Field id="description" label="Description">
              <Textarea id="description" name="description" placeholder="What is this workspace used for?"></Textarea>
            </Field>
            <PasswordInput id="api-secret" name="secret" label="API secret" showLabel="Show secret" hideLabel="Hide secret" value="Cetha-is-clear" />
            <Checkbox id="updates" name="updates" label="Product updates" description="Receive operational release notes." checked />
            <Switch id="alerts" name="alerts" label="Critical alerts" description="Notify administrators when availability drops." checked />
            <RadioGroup legend="Deployment policy" description="Choose how changes reach production.">
              <label class="radio-option"><input type="radio" name="policy" value="manual" checked /> Manual approval</label>
              <label class="radio-option"><input type="radio" name="policy" value="automatic" /> Automatic</label>
            </RadioGroup>
            <div class="compound-controls">
              <Combobox id="branch" name="branch" label="Pilih cabang" placeholder="Cari cabang…"><ComboboxOption value="jakarta" label="Jakarta HQ">Jakarta HQ</ComboboxOption><ComboboxOption value="bandung" label="Bandung">Bandung</ComboboxOption><ComboboxOption value="surabaya" label="Surabaya">Surabaya</ComboboxOption></Combobox>
              <InputGroup><span slot="start" class="input-affix">https://</span><Input aria-label="Workspace domain" value="arunika" /><span slot="end" class="input-affix">.cetha.app</span></InputGroup>
              <ButtonGroup label="Tampilan laporan"><Button size="sm" variant="primary">Ringkas</Button><Button size="sm">Rinci</Button><Button size="sm">Audit</Button></ButtonGroup>
            </div>
          </Surface>
        </section>

        <section id="feedback" class="doc-section">
          <header><p>03</p><div><h2>Feedback</h2><span>States that orient the operator without interrupting the task.</span></div></header>
          <div class="demo feedback-demo">
            <Alert tone="info" title="Configuration required">Connect a destination before enabling the workflow.</Alert>
            <Alert tone="success" title="Deployment complete">Version 2.4 is serving production traffic.</Alert>
            <div class="row-demo"><Loader label="Loading configuration" /><Skeleton width="11rem" /></div>
            <EmptyState title="No audit events" description="Events will appear after the first configuration change.">
              <Icon slot="icon" name="search" size={36} />
              <Button size="sm">Refresh</Button>
            </EmptyState>
          </div>
        </section>

        <section id="erp" class="doc-section">
          <header><p>04</p><div><h2>ERP patterns</h2><span>Identity, onboarding, plans, quota, upload, and activity primitives.</span></div></header>
          <div class="demo erp-stack">
            <div class="erp-row"><Avatar alt="Nadia Putri" initials="NP" status="online" /><AvatarGroup label="Tim finance"><Avatar alt="Raka" size="sm" /><Avatar alt="Maya" size="sm" /><Avatar alt="Dito" size="sm" /></AvatarGroup><div class="erp-stats"><Stat label="Pengguna" value="248" change="+12 bulan ini" trend="up" /><Stat label="Cabang" value="8" /></div></div>
            <Stepper label="Pembuatan perusahaan"><Step index={1} title="Perusahaan" state="complete" /><Step index={2} title="Administrasi" state="current" /><Step index={3} title="Modul" /></Stepper>
            <ProgressBar label="Kuota pengguna" value={72} showValue />
            <div class="erp-grid"><SelectableCard name="plan" value="growth" title="Growth" description="Untuk tim yang sedang berkembang." checked><strong>Rp499.000</strong> / bulan</SelectableCard><SelectableCard name="plan" value="scale" title="Scale" description="Kontrol lanjutan untuk banyak cabang."><strong>Rp899.000</strong> / bulan</SelectableCard></div>
            <FileInput id="company-logo" name="company-logo" label="Unggah logo perusahaan" description="PNG, JPG, atau SVG hingga 2 MB" accept="image/*" />
            <Card><CardHeader><strong>Aktivitas terbaru</strong></CardHeader><CardBody class="!p-0"><NotificationItem title="Pembayaran diterima" description="Invoice INV-2048 telah lunas." time="2 menit lalu" unread /><NotificationItem title="Pengguna baru" description="Maya bergabung ke cabang Jakarta." time="1 jam lalu" /></CardBody><CardFooter><Button size="sm" variant="ghost">Lihat semua</Button></CardFooter></Card>
            <div class="erp-shell"><NavigationRail label="Modul ERP"><Button size="sm" variant="primary" aria-label="Beranda">C</Button><Button size="sm" variant="ghost" aria-label="Pengaturan"><Icon name="settings" size={18} /></Button></NavigationRail><div class="relative flex min-h-36 flex-1 items-center justify-center text-sm text-cetha-text-subtle">Area kerja ERP<LoadingOverlay label="Memuat laporan" visible={false} /></div></div>
          </div>
        </section>

        <section id="overlays" class="doc-section">
          <header><p>05</p><div><h2>Overlays</h2><span>Disclosure, contextual content, and floating guidance with native foundations.</span></div></header>
          <div class="demo row-demo">
            <Button variant="primary" data-cetha-dialog-open="edit-dialog">Open dialog</Button>
            <Dropdown id="actions" align="end">
              <span slot="trigger">Actions</span>
              <button class="menu-item" role="menuitem">Duplicate</button>
              <button class="menu-item" role="menuitem">Move</button>
              <button class="menu-item danger" role="menuitem">Delete</button>
            </Dropdown>
            <Button id="toast-trigger">Show toast</Button>
            <Popover id="filter-popover" align="end"><span slot="trigger" class="popover-trigger">Filter options</span><strong>Report period</strong><p class="popover-copy">Choose a period before exporting the report.</p><Select aria-label="Report period"><option>Last 30 days</option><option>This quarter</option></Select></Popover>
            <Tooltip id="export-tip" content="Download report as CSV"><Button aria-label="Export report" variant="ghost"><Icon name="arrowRight" size={16} /> Export</Button></Tooltip>
            <Button data-cetha-dialog-open="filter-sheet">Open sheet</Button>
          </div>
          <div class="demo disclosure-demo">
            <Accordion label="Account questions"><AccordionItem title="Can I change my plan?" description="Plan and billing controls." open>Yes. Administrators can change the active plan from billing settings.</AccordionItem><AccordionItem title="How is usage calculated?">Usage is calculated from active users across all company branches.</AccordionItem></Accordion>
            <Collapsible label="Advanced options"><Surface bordered class="p-4">Configure tax rounding and invoice numbering.</Surface></Collapsible>
            <ContextMenu id="invoice-context" label="Invoice actions"><div slot="trigger" class="context-target"><strong>INV-2048</strong><span>Right-click for actions</span></div><ContextMenuItem shortcut="Enter">Open invoice</ContextMenuItem><ContextMenuItem>Duplicate</ContextMenuItem><ContextMenuItem danger>Delete draft</ContextMenuItem></ContextMenu>
          </div>
        </section>

        <section id="navigation" class="doc-section">
          <header><p>05</p><div><h2>Navigation</h2><span>Tabs, hierarchy, page movement, and responsive workspace navigation.</span></div></header>
          <div class="demo">
            <Breadcrumbs label="Breadcrumb"><li><a href="/">Home</a></li><li><a href="#navigation">Components</a></li><li aria-current="page">Navigation</li></Breadcrumbs>
            <Tabs id="settings-tabs" value="general" label="Settings sections">
              <Tab slot="list" tabsId="settings-tabs" value="general" active>General</Tab>
              <Tab slot="list" tabsId="settings-tabs" value="security">Security</Tab>
              <TabPanel tabsId="settings-tabs" value="general"><p>General settings are visible.</p></TabPanel>
              <TabPanel tabsId="settings-tabs" value="security"><p>Security settings are visible.</p></TabPanel>
            </Tabs>
            <Pagination page={2} pageCount={5} baseUrl="/" label="Examples" previousLabel="Previous" nextLabel="Next" />
          </div>
          <div id="demo-sidebar" class="sidebar-demo">
            <Button size="sm" data-cetha-sidebar-toggle="workspace-sidebar">Toggle navigation</Button>
            <Sidebar id="workspace-sidebar" label="Workspace" closeLabel="Close navigation" collapsible="all">
              <strong slot="header">Arunika</strong>
              <a class="nav-item active" href="#navigation">Overview</a>
              <a class="nav-item" href="#navigation">Deployments</a>
              <a class="nav-item" href="#navigation">Settings</a>
              <span slot="footer" class="footer-note">Production · healthy</span>
            </Sidebar>
          </div>
        </section>

        <section id="data" class="doc-section">
          <header><p>06</p><div><h2>Data</h2><span>Semantic tables remain readable before any client controller runs.</span></div></header>
          <Table caption="Recent deployments" compact>
            <tr slot="head"><th scope="col">Deployment</th><th scope="col">Status</th><th scope="col">Duration</th></tr>
            <tr><td>web-production-248</td><td><Badge tone="success">Healthy</Badge></td><td>42s</td></tr>
            <tr><td>worker-sync-031</td><td><Badge tone="warning">Building</Badge></td><td>18s</td></tr>
            <tr><td>api-staging-109</td><td><Badge>Queued</Badge></td><td>—</td></tr>
          </Table>
        </section>
      </div>
    </div>
  </main>

  <Dialog id="install-dialog" title="Install Cetha UI" description="Add the package and its compiled styles to an Astro project." closeLabel="Close dialog">
    <pre class="code-block"><code>npm install @charvesta/cetha</code></pre>
    <p class="dialog-copy">Then import the components and <code>@charvesta/cetha/styles</code> from your base layout.</p>
    <Button slot="footer" data-cetha-dialog-close="done" variant="primary">Done</Button>
  </Dialog>

  <Dialog id="edit-dialog" title="Edit workspace" description="Changes are local to this demonstration." closeLabel="Close dialog">
    <Field id="dialog-name" label="Workspace name"><Input id="dialog-name" value="Arunika Operations" /></Field>
    <Button slot="footer" data-cetha-dialog-close="cancel">Cancel</Button>
    <Button slot="footer" data-cetha-dialog-close="saved" variant="primary">Save changes</Button>
  </Dialog>
  <ToastRegion label="Notifications" />
  <Sheet id="filter-sheet" title="Filter laporan" description="Batasi data yang ditampilkan pada laporan." closeLabel="Close filters"><Field id="sheet-status" label="Status"><Select id="sheet-status"><option>Semua status</option><option>Lunas</option><option>Tertunda</option></Select></Field><Button slot="footer" data-cetha-dialog-close="apply" variant="primary">Apply filters</Button></Sheet>
  <CommandPalette id="erp-command" label="Cari di Cetha UI"><CommandItem label="Buka dashboard" keywords="beranda home" shortcut="G D"><Icon slot="icon" name="menu" size={17} /></CommandItem><CommandItem label="Pengaturan perusahaan" keywords="company settings"><Icon slot="icon" name="settings" size={17} /></CommandItem><CommandItem label="Cari pengguna" keywords="user team"><Icon slot="icon" name="search" size={17} /></CommandItem></CommandPalette>
</BaseLayout>

<script>
  import { showToast } from '@charvesta/cetha/client/toast';
  const bindToast = () => {
    const trigger = document.querySelector<HTMLButtonElement>('#toast-trigger');
    if (!trigger || trigger.dataset.bound) return;
    trigger.addEventListener('click', () => showToast({ tone: 'success', title: 'Configuration saved', message: 'The new values are active.' }));
    trigger.dataset.bound = 'true';
  };
  bindToast();
  document.addEventListener('astro:page-load', () => bindToast());

  const bindModeToggle = () => {
    const trigger = document.querySelector<HTMLButtonElement>('#mode-toggle');
    if (!trigger || trigger.dataset.bound) return;
    const root = document.documentElement;
    const label = trigger.querySelector<HTMLElement>('[data-mode-label]');
    const themeColor = document.querySelector<HTMLMetaElement>('[data-cetha-theme-color]');
    trigger.addEventListener('click', () => {
      const dark = root.dataset.cethaMode !== 'dark';
      root.dataset.cethaMode = dark ? 'dark' : 'light';
      trigger.setAttribute('aria-pressed', String(dark));
      if (label) label.textContent = dark ? 'Light mode' : 'Dark mode';
      if (themeColor) themeColor.content = dark ? '#191919' : '#fcfcfc';
    });
    trigger.dataset.bound = 'true';
  };
  bindModeToggle();
  document.addEventListener('astro:page-load', () => bindModeToggle());

  const bindCommandTrigger = () => document.querySelectorAll<HTMLElement>('[data-cetha-command-open]').forEach((trigger) => {
    if (trigger.dataset.bound) return;
    trigger.addEventListener('click', () => document.getElementById(trigger.dataset.cethaCommandOpen ?? '') instanceof HTMLDialogElement && (document.getElementById(trigger.dataset.cethaCommandOpen ?? '') as HTMLDialogElement).showModal());
    trigger.dataset.bound = 'true';
  });
  bindCommandTrigger();
  document.addEventListener('astro:page-load', bindCommandTrigger);
</script>

<style>
  .library-sidebar { position: fixed; inset: 0 auto 0 0; z-index: 40; display: flex; width: 272px; flex-direction: column; border-right: 1px solid var(--cetha-line); background: var(--cetha-base); padding: 0 12px 16px; }
  .sidebar-brand { display: flex; height: 48px; align-items: center; gap: 9px; padding: 0 8px; color: var(--cetha-text-strong); font-size: 14px; text-decoration: none; }
  .sidebar-search { display: flex; width: 100%; align-items: center; gap: 8px; margin: 12px 0; border: 1px solid var(--cetha-line); border-radius: var(--radius-cetha-md); background: var(--cetha-surface); padding: 8px 10px; color: var(--cetha-text-subtle); font-size: 13px; text-align: left; box-shadow: var(--shadow-cetha-sm); cursor: pointer; }
  .sidebar-search span { flex: 1; }
  .library-sidebar nav { display: flex; min-height: 0; flex: 1; flex-direction: column; gap: 2px; overflow-y: auto; padding: 4px; }
  .library-sidebar nav p { margin: 18px 8px 6px; color: var(--cetha-text-inactive); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  .library-sidebar nav a { border-radius: var(--radius-cetha-md); padding: 8px 10px; color: var(--cetha-text-subtle); font-size: 13px; text-decoration: none; transition: background var(--cetha-duration-fast), color var(--cetha-duration-fast); }
  .library-sidebar nav a:hover, .library-sidebar nav a.active { background: var(--cetha-control); color: var(--cetha-text-strong); }
  .sidebar-repo { display: flex; align-items: center; justify-content: space-between; border-top: 1px solid var(--cetha-line); padding: 14px 10px 0; color: var(--cetha-text-subtle); font-size: 12px; text-decoration: none; }
  .site-header { position: sticky; top: 0; z-index: 30; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; min-height: 48px; margin-left: 272px; padding: 0 16px; border-bottom: 1px solid var(--cetha-line); background: color-mix(in srgb, var(--cetha-base) 94%, transparent); backdrop-filter: blur(12px); }
  .brand { display: inline-flex; align-items: center; gap: 10px; width: fit-content; color: var(--cetha-text-strong); font-size: 14px; font-weight: 600; text-decoration: none; }
  .brand-mark { display: flex; align-items: end; gap: 2px; height: 18px; }
  .brand-mark i { display: block; width: 4px; border-radius: 2px; background: var(--cetha-brand); }
  .brand-mark i:nth-child(1) { height: 8px; } .brand-mark i:nth-child(2) { height: 18px; } .brand-mark i:nth-child(3) { height: 12px; }
  .package-version { justify-self: center; display: flex; align-items: center; gap: 8px; color: var(--cetha-text-subtle); font-family: "IBM Plex Mono", monospace; font-size: 12px; }
  .header-actions { justify-self: end; display: flex; align-items: center; gap: 12px; }
  .erp-stack { display: grid; gap: 24px; }
  .erp-row { display: flex; align-items: center; gap: 20px; }
  .erp-stats { margin-left: auto; display: flex; gap: 32px; }
  .erp-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .erp-shell { display: flex; overflow: hidden; min-height: 144px; border: 1px solid var(--cetha-line); border-radius: var(--radius-cetha-lg); background: var(--cetha-base); }
  .popover-trigger { display: inline-flex; height: 36px; align-items: center; border: 1px solid var(--cetha-line); border-radius: var(--radius-cetha-md); background: var(--cetha-surface); padding: 0 12px; color: var(--cetha-text-strong); font-size: 14px; font-weight: 500; cursor: pointer; }
  .popover-copy { margin: 6px 0 12px; color: var(--cetha-text-subtle); font-size: 12px; line-height: 1.6; }
  .disclosure-demo { display: grid; gap: 16px; }
  .compound-controls { display: grid; gap: 12px; padding-top: 8px; }
  .input-affix { display: inline-flex; height: 100%; align-items: center; background: var(--cetha-control); padding: 0 10px; color: var(--cetha-text-subtle); font-size: 12px; white-space: nowrap; }
  .context-target { display: flex; min-height: 72px; align-items: center; justify-content: space-between; border: 1px dashed var(--cetha-line-strong); border-radius: var(--radius-cetha-md); padding: 16px; color: var(--cetha-text-strong); }
  .context-target span { color: var(--cetha-text-subtle); font-size: 12px; font-weight: 400; }
  main { width: min(1120px, calc(100% - 320px)); margin: 0 auto 0 calc(272px + max(24px, (100vw - 272px - 1120px) / 2)); }
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 48px; min-height: 330px; padding: 64px 24px 48px; border-right: 1px solid var(--cetha-line); border-bottom: 1px solid var(--cetha-line); }
  .eyebrow { margin: 0 0 14px; color: var(--cetha-brand-text); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; }
  h1 { max-width: 760px; margin: 0; color: var(--cetha-text-strong); font-size: clamp(42px, 5vw, 64px); font-weight: 600; line-height: 1; letter-spacing: -.045em; }
  .lead { max-width: 620px; margin: 20px 0 0; color: var(--cetha-text-subtle); font-size: 14px; line-height: 1.65; }
  .intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; margin-top: 24px; }
  .install-line { display: flex; align-items: center; gap: 16px; padding-bottom: 4px; }
  .install-line code { color: var(--cetha-text-subtle); font-size: 12px; }
