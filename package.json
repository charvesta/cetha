{
  "name": "cetha-workspace",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "repository": "github:charvesta/cetha",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @charvesta/cetha-docs",
    "check": "npm run check --workspace @charvesta/cetha && npm run check --workspace @charvesta/cetha-docs",
    "dev": "npm run dev --workspace @charvesta/cetha-docs",
    "test": "npm run test:unit && npm run test:e2e && npm run test:package",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:package": "node scripts/verify-package.mjs",
    "pack:cetha": "mkdir -p artifacts && npm pack --workspace @charvesta/cetha --pack-destination artifacts",
    "pack:dry-run": "npm pack --workspace @charvesta/cetha --dry-run",
    "release": "changeset publish",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/node": "^11.0.2",
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.7",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.2.2",
    "astro": "^7.1.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "sharp": "^0.35.0"
  }
}
