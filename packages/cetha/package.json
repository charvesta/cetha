{
  "name": "@charvesta/cetha",
  "version": "0.1.4",
  "description": "Astro-native, SSR-safe UI components for product interfaces.",
  "type": "module",
  "license": "MIT",
  "author": "Charvesta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/charvesta/cetha.git",
    "directory": "packages/cetha"
  },
  "homepage": "https://github.com/charvesta/cetha#readme",
  "bugs": "https://github.com/charvesta/cetha/issues",
  "keywords": [
    "astro",
