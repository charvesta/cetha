---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'details'> {
  title: string;
  description?: string;
  open?: boolean;
  disabled?: boolean;
}

const { title, description, open = false, disabled = false, class: className, ...attrs } = Astro.props;
---

<details class:list={['group', className]} {open} data-cetha-accordion-item {...attrs}>
  <summary
    class:list={[
      'cetha-focus m-1 flex list-none items-start gap-3 rounded-cetha-md px-3 py-2.5 text-left transition-colors [&::-webkit-details-marker]:hidden',
      disabled ? 'pointer-events-none cursor-not-allowed opacity-50' : 'cursor-pointer hover:bg-cetha-control',
    ]}
    aria-disabled={disabled ? 'true' : undefined}
  >
    <span class="min-w-0 flex-1"><span class="block text-sm font-medium text-cetha-text-strong">{title}</span>{description && <span class="mt-0.5 block text-xs leading-5 text-cetha-text-subtle">{description}</span>}</span>
    <Icon name="chevronDown" size={16} class="mt-0.5 text-cetha-text-subtle transition-transform group-open:rotate-180" />
  </summary>
  <div class="px-4 pb-4 pt-1 text-sm leading-6 text-cetha-text"><slot /></div>
</details>
