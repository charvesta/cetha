---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

type Tone = 'info' | 'success' | 'warning' | 'danger';
interface Props extends HTMLAttributes<'div'> { tone?: Tone; title?: string; }
const { tone = 'info', title, class: className, ...attrs } = Astro.props;
const tones: Record<Tone, string> = {
  info: 'bg-cetha-info-soft text-cetha-info',
  success: 'bg-cetha-success-soft text-cetha-success',
  warning: 'bg-cetha-warning-soft text-cetha-warning',
  danger: 'bg-cetha-danger-soft text-cetha-danger',
};
const icons = { info: 'info', success: 'success', warning: 'warning', danger: 'alert' } as const;
---

<div class:list={['flex items-start gap-3 rounded-cetha-md px-4 py-3 text-sm', tones[tone], className]} role={tone === 'danger' ? 'alert' : 'status'} {...attrs}>
  <Icon name={icons[tone]} size={18} class="mt-0.5" />
  <div class="min-w-0">
    {title && <p class="font-medium">{title}</p>}
    <div class:list={[title && 'mt-0.5', 'leading-6']}><slot /></div>
  </div>
</div>
