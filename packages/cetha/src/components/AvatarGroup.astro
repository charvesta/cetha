---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> { label: string; }
const { label, class: className, ...attrs } = Astro.props;
---
<div class:list={['flex -space-x-2 [&>*]:ring-2 [&>*]:ring-cetha-surface', className]} role="group" aria-label={label} {...attrs}><slot /></div>
