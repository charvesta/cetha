---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost' | 'danger';
type Size = 'sm' | 'md' | 'lg';

interface Props extends HTMLAttributes<'button'> {
  variant?: Variant;
  size?: Size;
  loading?: boolean;
}

const {
  variant = 'secondary',
  size = 'md',
  loading = false,
  disabled = false,
  class: className,
  type = 'button',
  ...attrs
} = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-cetha-brand text-white hover:bg-cetha-brand-strong',
  secondary: 'border border-cetha-line bg-cetha-surface text-cetha-text-strong hover:bg-cetha-control',
  ghost: 'bg-transparent text-cetha-text hover:bg-cetha-control',
  danger: 'bg-cetha-danger text-white hover:brightness-95',
};
const sizes: Record<Size, string> = {
  sm: 'h-8 rounded-cetha-sm px-3 text-xs',
  md: 'h-9 rounded-cetha-md px-3.5 text-sm',
  lg: 'h-10 rounded-cetha-md px-4 text-sm',
};
---

<button
  type={type}
  class:list={[
    'cetha-focus inline-flex items-center justify-center gap-2 font-medium transition-transform disabled:opacity-50',
    variants[variant],
    sizes[size],
    loading ? 'cursor-wait active:translate-y-0' : 'active:translate-y-px disabled:cursor-not-allowed',
    className,
  ]}
  disabled={disabled || loading}
  aria-busy={loading ? 'true' : undefined}
  {...attrs}
>
  {loading && <span class="h-4 w-4 animate-spin rounded-full border-2 border-current border-r-transparent" aria-hidden="true"></span>}
  <slot />
</button>
