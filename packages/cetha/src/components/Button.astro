---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'ghost' | 'danger' | 'secondary-danger' | 'outline';
type Size = 'xs' | 'sm' | 'md' | 'lg';
type Shape = 'base' | 'square' | 'circle';

interface Props extends HTMLAttributes<'button'> {
  variant?: Variant;
  size?: Size;
  shape?: Shape;
  loading?: boolean;
}

const {
  variant = 'secondary',
  size = 'md',
  shape = 'base',
  loading = false,
  disabled = false,
  class: className,
  type = 'button',
  ...attrs
} = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-cetha-brand text-white ring-1 ring-[color-mix(in_oklch,var(--cetha-brand),black_10%)]',
  secondary: 'bg-cetha-surface text-cetha-text-strong ring-1 ring-cetha-line hover:bg-cetha-control',
  ghost: 'bg-transparent text-cetha-text shadow-none hover:bg-cetha-control hover:text-cetha-text-strong',
  danger: 'bg-cetha-danger text-white ring-1 ring-[color-mix(in_oklch,var(--cetha-danger),black_10%)]',
  'secondary-danger': 'bg-cetha-surface text-cetha-danger ring-1 ring-cetha-line hover:ring-[color-mix(in_srgb,var(--cetha-danger)_30%,transparent)]',
  outline: 'bg-transparent text-cetha-text ring-1 ring-cetha-line hover:text-cetha-text-strong hover:ring-[color-mix(in_srgb,var(--cetha-focus)_25%,transparent)]',
};
const sizes: Record<Size, string> = {
  xs: 'h-5 gap-1 rounded-cetha-sm px-1.5 text-xs',
  sm: 'h-[26px] gap-1 rounded-cetha-md px-2 text-xs',
  md: 'h-9 gap-1.5 rounded-cetha-md px-3 text-base',
  lg: 'h-10 gap-2 rounded-cetha-md px-4 text-base',
};
const compactSizes: Record<Size, string> = { xs: 'w-5', sm: 'w-[26px]', md: 'w-9', lg: 'w-10' };
const shapes: Record<Shape, string> = {
  base: '',
  square: 'shrink-0 justify-center px-0',
  circle: 'shrink-0 justify-center rounded-full px-0',
};
const emphasis = variant === 'primary' || variant === 'danger';
const emphasisOverlay = variant === 'danger'
  ? 'from-[color-mix(in_oklch,var(--cetha-danger),white_15%)] to-cetha-danger shadow-[inset_0_1px_0_0_color-mix(in_oklch,var(--cetha-danger),white_30%)] group-hover:from-[color-mix(in_oklch,var(--cetha-danger),white_30%)]'
  : 'from-[color-mix(in_oklch,var(--cetha-brand),white_15%)] to-cetha-brand shadow-[inset_0_1px_0_0_color-mix(in_oklch,var(--cetha-brand),white_30%)] group-hover:from-[color-mix(in_oklch,var(--cetha-brand),white_30%)]';
---

<button
  type={type}
  class:list={[
    'cetha-focus group relative inline-flex w-max appearance-none items-center whitespace-nowrap border-0 font-medium leading-none shadow-cetha-sm transition-[background-color,color,box-shadow] select-none disabled:opacity-50',
    variants[variant],
    sizes[size],
    shapes[shape],
    shape !== 'base' && compactSizes[size],
    loading ? 'cursor-wait' : 'disabled:cursor-not-allowed',
    className,
  ]}
  disabled={disabled || loading}
  aria-busy={loading ? 'true' : undefined}
  {...attrs}
>
  {emphasis && <span class:list={['pointer-events-none absolute inset-0 rounded-[inherit] bg-gradient-to-b', emphasisOverlay]} aria-hidden="true"></span>}
  <span class="relative inline-flex items-center gap-[inherit]">
    {loading && <span class="h-4 w-4 animate-spin rounded-full border-2 border-current border-r-transparent" aria-hidden="true"></span>}
    <slot />
  </span>
</button>
