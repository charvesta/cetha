---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
interface Props extends HTMLAttributes<'button'> { value: string; label?: string; selected?: boolean; disabled?: boolean; }
const { value, label = value, selected = false, disabled = false, class: className, ...attrs } = Astro.props;
---
<button type="button" class:list={['cetha-focus group flex w-full appearance-none items-center gap-2 border-0 bg-transparent px-2.5 py-2 text-left text-sm text-cetha-text transition-colors hover:bg-cetha-control aria-selected:bg-cetha-brand-soft aria-selected:text-cetha-brand-text-strong disabled:cursor-not-allowed disabled:opacity-50', className]} role="option" aria-selected={selected} {disabled} data-cetha-combobox-option data-value={value} data-label={label} {...attrs}><span class="flex-1"><slot />{!Astro.slots.has('default') && label}</span><Icon name="check" size={15} class="invisible text-cetha-brand-text group-aria-selected:visible" /></button>
