---
import type { HTMLAttributes } from 'astro/types'; import Icon from './Icon.astro'; import Kbd from './Kbd.astro';
interface Props extends HTMLAttributes<'dialog'> { id: string; label: string; placeholder?: string; emptyLabel?: string; }
const { id, label, placeholder = 'Cari menu atau aksi…', emptyLabel = 'Tidak ada hasil', class: className, ...attrs } = Astro.props;
---
<dialog id={id} class:list={['m-auto w-[min(38rem,calc(100%-2rem))] overflow-hidden rounded-cetha-lg border border-cetha-line bg-cetha-raised p-0 text-cetha-text shadow-cetha-lg backdrop:bg-[var(--cetha-overlay)]', className]} aria-label={label} data-cetha-command-palette {...attrs}>
  <div class="flex items-center gap-3 border-b border-cetha-line px-4"><Icon name="search" size={18} class="text-cetha-text-subtle" /><input class="h-13 min-w-0 flex-1 appearance-none border-0 bg-transparent text-sm text-cetha-text-strong outline-none placeholder:text-cetha-text-inactive" type="search" placeholder={placeholder} aria-label={label} data-cetha-command-input /><Kbd>Esc</Kbd></div>
  <div class="max-h-80 overflow-y-auto p-1.5" role="listbox" data-cetha-command-list><slot /></div>
  <p class="hidden px-4 py-10 text-center text-sm text-cetha-text-subtle" data-cetha-command-empty>{emptyLabel}</p>
  <footer class="flex items-center gap-4 border-t border-cetha-line bg-cetha-base px-4 py-2 text-[11px] text-cetha-text-subtle"><span><Kbd>↑</Kbd> <Kbd>↓</Kbd> navigasi</span><span><Kbd>Enter</Kbd> pilih</span></footer>
</dialog>
<script>import { initCommandPalettes } from '../client/command-palette'; initCommandPalettes(); document.addEventListener('astro:page-load', () => initCommandPalettes());</script>
