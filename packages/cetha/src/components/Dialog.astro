---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'dialog'> {
  id: string;
  title: string;
  description?: string;
  closeLabel: string;
  closeOnBackdrop?: boolean;
}

const {
  id,
  title,
  description,
  closeLabel,
  closeOnBackdrop = true,
  class: className,
  ...attrs
} = Astro.props;
---

<dialog
  id={id}
  class:list={[
    'm-auto w-[min(92vw,34rem)] rounded-cetha-lg border border-cetha-line bg-cetha-raised p-0 text-cetha-text shadow-cetha backdrop:bg-[var(--cetha-overlay)] open:animate-[cetha-dialog-in_var(--cetha-duration-normal)_ease-out]',
    className,
  ]}
  aria-labelledby={`${id}-title`}
  aria-describedby={description ? `${id}-description` : undefined}
  data-cetha-dialog
  data-close-on-backdrop={String(closeOnBackdrop)}
  {...attrs}
>
  <div class="flex items-start justify-between gap-5 border-b border-cetha-line px-5 py-4">
    <div class="min-w-0">
      <h2 id={`${id}-title`} class="text-lg font-semibold text-cetha-text-strong">{title}</h2>
      {description && <p id={`${id}-description`} class="mt-1 text-sm leading-6 text-cetha-text-subtle">{description}</p>}
    </div>
    <button type="button" class="cetha-focus inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-cetha-sm text-cetha-text-subtle hover:bg-cetha-control hover:text-cetha-text-strong" aria-label={closeLabel} data-cetha-dialog-close="dismiss">
      <Icon name="close" size={18} />
    </button>
  </div>
  <div class="px-5 py-5"><slot /></div>
  <div class="flex flex-wrap justify-end gap-2 border-t border-cetha-line px-5 py-4"><slot name="footer" /></div>
</dialog>

<script>
  import { initDialogs } from '../client/dialog';
  initDialogs();
  document.addEventListener('astro:page-load', () => initDialogs());
</script>
