---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> { title: string; description?: string; }
const { title, description, class: className, ...attrs } = Astro.props;
---

<div class:list={['grid justify-items-center px-6 py-12 text-center', className]} {...attrs}>
  <div class="mb-4 text-cetha-text-inactive"><slot name="icon" /></div>
  <h3 class="text-sm font-semibold text-cetha-text-strong">{title}</h3>
  {description && <p class="mt-1 max-w-md text-sm leading-6 text-cetha-text-subtle">{description}</p>}
  <div class="mt-5 flex flex-wrap justify-center gap-2"><slot /></div>
</div>
