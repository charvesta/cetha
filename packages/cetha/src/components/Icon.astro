---
import type { HTMLAttributes } from 'astro/types';
import { phosphorIcons, type PhosphorIconName } from '../icons/phosphor';

interface Props extends HTMLAttributes<'svg'> {
  name: PhosphorIconName;
  label?: string;
  size?: number;
  /** Retained for API compatibility; Phosphor regular icons use filled path geometry. */
  strokeWidth?: number;
}

const { name, label, size = 20, strokeWidth: _strokeWidth, class: className, ...attrs } = Astro.props;
---

<svg
  class:list={['shrink-0', className]}
  width={size}
  height={size}
  viewBox="0 0 256 256"
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  {...attrs}
>
  <path d={phosphorIcons[name]} />
</svg>
