---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
  subtle?: boolean;
}

const { subtle = false, class: className, ...attrs } = Astro.props;
---

<a
  class:list={[
    'cetha-focus inline-flex items-center gap-1 rounded-cetha-sm text-sm font-medium underline-offset-4 hover:underline',
    subtle ? 'text-cetha-text-subtle hover:text-cetha-text-strong' : 'text-cetha-brand-text hover:text-cetha-brand-text-strong',
    className,
  ]}
  {...attrs}
><slot /></a>
