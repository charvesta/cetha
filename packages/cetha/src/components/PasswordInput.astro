---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'input'> {
  id: string;
  label: string;
  description?: string;
  error?: string;
  showLabel: string;
  hideLabel: string;
}

const {
  id,
  label,
  description,
  error,
  showLabel,
  hideLabel,
  class: className,
  ...attrs
} = Astro.props;
const describedBy = [description && `${id}-description`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
---

<div class="grid gap-1.5" data-cetha-password>
  <label class="text-sm font-medium text-cetha-text-strong" for={id}>{label}</label>
  {description && <p id={`${id}-description`} class="text-xs leading-5 text-cetha-text-subtle">{description}</p>}
  <div class="relative">
    <input
      id={id}
      type="password"
      class:list={[
        'cetha-focus min-h-10 w-full rounded-cetha-md border bg-cetha-surface px-3 py-2 pr-11 text-sm text-cetha-text-strong placeholder:text-cetha-text-inactive',
        error ? 'border-cetha-danger' : 'border-cetha-line hover:border-cetha-line-strong',
        className,
      ]}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      {...attrs}
    />
    <button
      type="button"
      class="cetha-focus absolute right-1 top-1 inline-flex h-8 w-8 items-center justify-center rounded-cetha-sm text-cetha-text-subtle hover:bg-cetha-control hover:text-cetha-text-strong"
      aria-label={showLabel}
      data-cetha-password-toggle
      data-show-label={showLabel}
      data-hide-label={hideLabel}
    >
      <span data-cetha-password-show><Icon name="eye" size={18} /></span>
      <span data-cetha-password-hide hidden><Icon name="eyeOff" size={18} /></span>
    </button>
  </div>
  {error && <p id={`${id}-error`} class="text-xs leading-5 text-cetha-danger" role="alert">{error}</p>}
</div>

<script>
  import { initPasswordInputs } from '../client/password-input';
  initPasswordInputs();
  document.addEventListener('astro:page-load', () => initPasswordInputs());
</script>
