---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

interface Props extends HTMLAttributes<'input'> {
  id: string;
  label: string;
  description?: string;
  error?: string;
  showLabel: string;
  hideLabel: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  id,
  label,
  description,
  error,
  showLabel,
  hideLabel,
  size = 'md',
  class: className,
  ...attrs
} = Astro.props;
const describedBy = [description && `${id}-description`, error && `${id}-error`].filter(Boolean).join(' ') || undefined;
const sizes = {
  sm: { input: 'h-7 rounded-cetha-sm pl-2.5 pr-8 text-xs', button: 'right-0.5 top-0.5 h-6 w-6' },
  md: { input: 'h-9 rounded-cetha-md pl-3 pr-10 text-sm', button: 'right-0.5 top-0.5 h-8 w-8' },
  lg: { input: 'h-10 rounded-cetha-md pl-3 pr-11 text-sm', button: 'right-1 top-1 h-8 w-8' },
} as const;
---

<div class="grid gap-1.5" data-cetha-password>
  <label class="text-sm font-medium text-cetha-text-strong" for={id}>{label}</label>
  {description && <p id={`${id}-description`} class="text-xs leading-5 text-cetha-text-subtle">{description}</p>}
  <div class="relative">
    <input
      id={id}
      type="password"
      class:list={[
        'cetha-focus w-full border bg-cetha-surface text-cetha-text-strong placeholder:text-cetha-text-inactive',
        sizes[size].input,
        error ? 'border-cetha-danger' : 'border-cetha-line hover:border-cetha-line-strong',
        className,
      ]}
      aria-invalid={error ? 'true' : undefined}
      aria-describedby={describedBy}
      {...attrs}
    />
    <button
      type="button"
      class:list={['cetha-focus absolute inline-flex appearance-none items-center justify-center border-0 bg-transparent p-0 text-cetha-text-subtle transition-colors hover:bg-cetha-control hover:text-cetha-text-strong', sizes[size].button]}
      aria-label={showLabel}
      data-cetha-password-toggle
      data-show-label={showLabel}
      data-hide-label={hideLabel}
    >
      <span data-cetha-password-show><Icon name="eye" size={18} /></span>
      <span data-cetha-password-hide hidden><Icon name="eyeOff" size={18} /></span>
    </button>
  </div>
  {error && <p id={`${id}-error`} class="text-xs leading-5 text-cetha-danger" role="alert">{error}</p>}
</div>

<script>
  import { initPasswordInputs } from '../client/password-input';
  initPasswordInputs();
  document.addEventListener('astro:page-load', () => initPasswordInputs());
</script>
