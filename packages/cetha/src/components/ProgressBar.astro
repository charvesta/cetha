---
import type { HTMLAttributes } from 'astro/types';
interface Props extends HTMLAttributes<'div'> { value: number; max?: number; label: string; showValue?: boolean; tone?: 'brand' | 'success' | 'warning' | 'danger'; size?: 'sm' | 'md'; }
const { value, max = 100, label, showValue = false, tone = 'brand', size = 'md', class: className, ...attrs } = Astro.props;
const safe = Math.min(Math.max(value, 0), max); const percent = max > 0 ? Math.round((safe / max) * 100) : 0;
const tones = { brand: 'bg-cetha-brand', success: 'bg-cetha-success', warning: 'bg-cetha-warning', danger: 'bg-cetha-danger' };
---
<div class:list={['grid gap-1.5', className]} {...attrs}>
  <div class="flex items-center justify-between gap-3 text-xs"><span class="font-medium text-cetha-text-strong">{label}</span>{showValue && <span class="tabular-nums text-cetha-text-subtle">{percent}%</span>}</div>
  <div class:list={['overflow-hidden rounded-full bg-cetha-control', size === 'sm' ? 'h-1.5' : 'h-2']} role="progressbar" aria-label={label} aria-valuenow={safe} aria-valuemin="0" aria-valuemax={max}><div class:list={['h-full rounded-full transition-[width] duration-300', tones[tone]]} style={`width:${percent}%`}></div></div>
</div>
