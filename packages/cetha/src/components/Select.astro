---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'select'> {
  invalid?: boolean;
  size?: 'sm' | 'md' | 'lg';
}
const { invalid = false, size = 'md', class: className, ...attrs } = Astro.props;
const sizes = {
  sm: 'h-8 px-2.5 text-xs',
  md: 'h-9 px-3 text-sm',
  lg: 'h-10 px-3 text-sm',
} as const;
---

<select
  class:list={[
    'cetha-focus w-full rounded-cetha-md border bg-cetha-surface text-cetha-text-strong disabled:cursor-not-allowed disabled:bg-cetha-control',
    sizes[size],
    invalid ? 'border-cetha-danger' : 'border-cetha-line hover:border-cetha-line-strong',
    className,
  ]}
  aria-invalid={invalid ? 'true' : undefined}
  {...attrs}
><slot /></select>
