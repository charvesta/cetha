---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'select'> { invalid?: boolean; }
const { invalid = false, class: className, ...attrs } = Astro.props;
---

<select
  class:list={[
    'cetha-focus min-h-10 w-full rounded-cetha-md border bg-cetha-surface px-3 py-2 text-sm text-cetha-text-strong disabled:cursor-not-allowed disabled:bg-cetha-control',
    invalid ? 'border-cetha-danger' : 'border-cetha-line hover:border-cetha-line-strong',
    className,
  ]}
  aria-invalid={invalid ? 'true' : undefined}
  {...attrs}
><slot /></select>
