---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
interface Props extends HTMLAttributes<'dialog'> { id: string; title: string; description?: string; closeLabel: string; side?: 'left' | 'right' | 'top' | 'bottom'; size?: 'sm' | 'md' | 'lg'; closeOnBackdrop?: boolean; }
const { id, title, description, closeLabel, side = 'right', size = 'md', closeOnBackdrop = true, class: className, ...attrs } = Astro.props;
const geometry = {
  left: `mr-auto h-full max-h-none ${size === 'sm' ? 'w-72' : size === 'lg' ? 'w-[32rem]' : 'w-96'}`,
  right: `ml-auto h-full max-h-none ${size === 'sm' ? 'w-72' : size === 'lg' ? 'w-[32rem]' : 'w-96'}`,
  top: `mb-auto w-full max-w-none ${size === 'sm' ? 'min-h-48' : size === 'lg' ? 'min-h-96' : 'min-h-72'}`,
  bottom: `mt-auto w-full max-w-none ${size === 'sm' ? 'min-h-48' : size === 'lg' ? 'min-h-96' : 'min-h-72'}`,
};
---
<dialog id={id} class:list={['m-0 max-w-full overflow-hidden border border-cetha-line bg-cetha-raised p-0 text-cetha-text shadow-cetha-lg backdrop:bg-[var(--cetha-overlay)]', geometry[side], className]} aria-labelledby={`${id}-title`} aria-describedby={description ? `${id}-description` : undefined} data-cetha-dialog data-cetha-sheet data-side={side} data-close-on-backdrop={String(closeOnBackdrop)} {...attrs}>
  <div class="flex h-full flex-col"><header class="flex items-start justify-between gap-4 border-b border-cetha-line px-5 py-4"><div><h2 id={`${id}-title`} class="text-lg font-semibold text-cetha-text-strong">{title}</h2>{description && <p id={`${id}-description`} class="mt-1 text-sm leading-6 text-cetha-text-subtle">{description}</p>}</div><button type="button" class="cetha-focus inline-flex size-8 shrink-0 items-center justify-center rounded-cetha-sm text-cetha-text-subtle hover:bg-cetha-control" aria-label={closeLabel} data-cetha-dialog-close="dismiss"><Icon name="close" size={18} /></button></header><div class="min-h-0 flex-1 overflow-y-auto px-5 py-5"><slot /></div><footer class="flex justify-end gap-2 border-t border-cetha-line px-5 py-4"><slot name="footer" /></footer></div>
</dialog>
<script>import { initDialogs } from '../client/dialog'; initDialogs(); document.addEventListener('astro:page-load', () => initDialogs());</script>
