---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import Button from './Button.astro';

interface Props extends HTMLAttributes<'div'> {
  id: string;
  label: string;
  open?: boolean;
  closeLabel?: string;
  collapsible?: 'desktop' | 'mobile' | 'all';
  width?: 'sm' | 'md' | 'lg';
  side?: 'left' | 'right';
}

const {
  id,
  label,
  open = false,
  closeLabel,
  collapsible = 'mobile',
  width = 'md',
  side = 'left',
  class: className,
  ...attrs
} = Astro.props;
const widths = { sm: 'w-56', md: 'w-64', lg: 'w-80' } as const;
const sides = {
  left: 'left-0 border-r border-cetha-line',
  right: 'right-0 border-l border-cetha-line',
} as const;
const closeVisibility = {
  mobile: 'inline-flex md:hidden',
  desktop: 'hidden md:inline-flex',
  all: 'inline-flex',
} as const;
---

<div
  id={id}
  class:list={['relative', className]}
  data-cetha-sidebar
  data-open={String(open)}
  data-collapsible={collapsible}
  data-side={side}
  data-width={width}
  {...attrs}
>
  <button
    type="button"
    class="fixed inset-0 z-40 bg-[var(--cetha-overlay)] transition-opacity md:hidden"
    aria-label={closeLabel ?? label}
    aria-hidden="true"
    tabindex="-1"
    data-cetha-sidebar-backdrop
    hidden={!open}
  ></button>
  <nav class:list={['fixed inset-y-0 z-50 flex flex-col bg-cetha-surface transition-transform', widths[width], sides[side]]} aria-label={label} data-cetha-sidebar-panel>
    <div class="flex min-h-14 items-center gap-3 border-b border-cetha-line px-5 py-3">
      <div class="min-w-0 flex-1"><slot name="header" /></div>
      {closeLabel && (
        <Button type="button" size="md" shape="square" variant="ghost" class={closeVisibility[collapsible]} aria-label={closeLabel} data-cetha-sidebar-close>
          <Icon name="close" size={18} />
        </Button>
      )}
    </div>
    <div class="min-h-0 flex-1 overflow-y-auto p-3"><slot /></div>
    <div class="border-t border-cetha-line px-3 py-3"><slot name="footer" /></div>
  </nav>
</div>

<script>
  import { initSidebars } from '../client/sidebar';
  initSidebars();
  document.addEventListener('astro:page-load', () => initSidebars());
</script>
