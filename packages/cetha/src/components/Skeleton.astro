---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> { width?: string; height?: string; }
const { width = '100%', height = '1rem', class: className, style, ...attrs } = Astro.props;
const mergedStyle = `width:${width};height:${height};${style ?? ''}`;
---

<span class:list={['block animate-pulse rounded-cetha-sm bg-cetha-control', className]} style={mergedStyle} aria-hidden="true" {...attrs}></span>
