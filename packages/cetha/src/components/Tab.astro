---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'button'> {
  tabsId: string;
  value: string;
  active?: boolean;
}

const { tabsId, value, active = false, class: className, ...attrs } = Astro.props;
---

<button
  id={`${tabsId}-tab-${value}`}
  type="button"
  class:list={[
    'cetha-focus relative z-[1] my-0.5 flex h-8 shrink-0 appearance-none items-center whitespace-nowrap rounded-cetha-md border-0 bg-transparent px-2.5 text-sm font-medium text-cetha-text-subtle transition-[background-color,color,box-shadow] hover:text-cetha-text-strong aria-selected:bg-cetha-surface aria-selected:text-cetha-text-strong aria-selected:shadow-cetha-sm aria-selected:ring-1 aria-selected:ring-cetha-line',
    className,
  ]}
  role="tab"
  aria-controls={`${tabsId}-panel-${value}`}
  aria-selected={active}
  tabindex={active ? 0 : -1}
  data-cetha-tab
  data-value={value}
  {...attrs}
><slot /></button>
