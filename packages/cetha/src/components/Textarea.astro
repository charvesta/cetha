---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'textarea'> {
  invalid?: boolean;
  size?: 'sm' | 'md' | 'lg';
  value?: string | number;
}

const { invalid = false, size = 'md', value = '', class: className, ...attrs } = Astro.props;
const sizes = {
  sm: 'rounded-cetha-sm px-2.5 py-1.5 text-xs leading-5',
  md: 'rounded-cetha-md px-3 py-2 text-sm leading-5',
  lg: 'rounded-cetha-md px-3 py-2.5 text-sm leading-6',
} as const;
---

<textarea
  class:list={[
    'cetha-focus w-full resize-y border bg-cetha-surface text-cetha-text-strong placeholder:text-cetha-text-inactive disabled:cursor-not-allowed disabled:bg-cetha-control',
    sizes[size],
    invalid ? 'border-cetha-danger' : 'border-cetha-line hover:border-cetha-line-strong',
    className,
  ]}
  aria-invalid={invalid ? 'true' : undefined}
  {...attrs}
>{value}</textarea>
