---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'div'> { id?: string; label: string; }
const { id = 'cetha-toasts', label, class: className, ...attrs } = Astro.props;
---

<div id={id} class:list={['pointer-events-none fixed bottom-4 right-4 z-[100] grid w-[min(24rem,calc(100vw-2rem))] gap-2', className]} aria-label={label} aria-live="polite" aria-relevant="additions" {...attrs}></div>
